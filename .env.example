OVERPASS_TIMEOUT_SECONDS=120
OPENSTREETMAP_REQUESTS_PER_SECOND=0.5
OPENSTREETMAP_USER_AGENT=ClientParserMap/1.0

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_ALL_COMPANIES_WORKSHEET=Все компании
GOOGLE_SHEETS_QUALIFIED_LEADS_WORKSHEET=Готовые лиды
GOOGLE_SHEETS_SEARCH_RUNS_WORKSHEET=Запуски поиска
GOOGLE_SERVICE_ACCOUNT_FILE=

LEAD_SCORE_THRESHOLD=50
SCORING_RULES_FILE=app/scoring/scoring_rules.toml
NICHE_PRESETS_FILE=app/presets/niche_presets.toml
