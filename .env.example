WEBSITE_TIMEOUT_SECONDS=10
MAX_CONCURRENT_WEBSITE_CHECKS=10
MAX_WEBSITE_REDIRECTS=5
MAX_HTML_BYTES=5000000
MAX_CONTACT_PAGES=8
